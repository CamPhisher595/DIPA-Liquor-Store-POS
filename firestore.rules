rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasStoreAccess(storeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId;
    }

    function isStoreAdmin(storeId) {
      return hasStoreAccess(storeId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /stores/{storeId}/shared/{documentId} {
      allow read: if hasStoreAccess(storeId);
      allow write: if isStoreAdmin(storeId);
    }

    match /stores/{storeId}/transactions/{transactionId} {
      allow read, write: if hasStoreAccess(storeId);
    }
  }
}
