rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasStoreAccess(storeId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeId == storeId;
    }

    function isStoreAdmin(storeId) {
      return hasStoreAccess(storeId)
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /stores/{storeId}/{allPaths=**} {
      allow read: if hasStoreAccess(storeId);
      allow create, update: if isStoreAdmin(storeId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStoreAdmin(storeId);
    }
  }
}
